{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound95",
  "version": "0.5.0",
  "identifier": "com.fo4an.sound95",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://w.soundcloud.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; frame-src https://w.soundcloud.com; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Sound95",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "FO4AN",
    "category": "Music",
    "shortDescription": "A Windows 95 style SoundCloud client",
    "longDescription": "Sound95 is a Windows 95 style desktop client for SoundCloud, with a visualizer and karaoke.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MUFCRkNCNDRCMUYyNjEKUldSaDhyRkV5NzhhcEc4UWs3bDhaVGttZGowSTRYZXozb2Z1UWd5RGNYYllGRTRoRGJVcXFCcVcK",
      "endpoints": [
        "https://github.com/FO4AN/sound95/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
