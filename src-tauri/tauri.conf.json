{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "withGlobalTauri": false
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "SoundScape",
        "width": 860,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": "icons/icon.png",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialogFormat": "default",
      "strategy": "github",
      "allowHigherVersions": true,
      "createUpdaterArtifacts": true,
      "publishing": {
        "provider": "github",
        "owner": "FO4AN",
        "repo": "soundscape",
        "releaseCommit": null
      },
      "endpoints": [
        "https://github.com/FO4AN/soundscape/releases/latest/download/{arch}-latest.json"
      ]
    }
  }
}
